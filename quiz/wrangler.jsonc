{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hompub-quiz",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // Static pages (join, play, host) are served as assets: free and unlimited.
  // Only /api/* reaches the Worker and counts against the daily request budget.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  // SQLite-backed classes are the only kind the Workers Free plan can create.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] }
  ],
  // Secrets are not here. Set them per Worker in the Cloudflare dashboard
  // (Settings → Variables and Secrets): HOST_PASSCODE, SESSION_KEY, IP_HASH_KEY.
  // Never put DEV_* switches here: they belong in .dev.vars only (test/config.test.mjs checks).
  "vars": {
    "ALLOWED_ORIGINS": "",
    "MAX_PLAYERS": "400",
    "ROOM_CREATE_PER_IP_PER_DAY": "30",
    "ROOM_CREATE_PER_DAY": "300",
    "PIN_MISS_LIMIT": "100"
  },
  // Privacy commitment: no request logs, no traces. Keep this off.
  "observability": { "enabled": false },

  // Staging: `wrangler deploy --env staging`, deployed by .github/workflows/deploy-quiz-staging.yml
  // into a separate Cloudflare account. Bindings and vars do not inherit, so they are repeated
  // here exactly; test/config.test.mjs fails if the two blocks drift apart.
  "env": {
    "staging": {
      "name": "hompub-quiz-staging",
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "DIRECTORY", "class_name": "Directory" }
        ]
      },
      "vars": {
        "ALLOWED_ORIGINS": "",
        "MAX_PLAYERS": "400",
        "ROOM_CREATE_PER_IP_PER_DAY": "30",
        "ROOM_CREATE_PER_DAY": "300",
        "PIN_MISS_LIMIT": "100"
      }
    }
  }
}
